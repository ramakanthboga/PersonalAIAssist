# ──────────────────────────────────────────────────────────────────────
# PersonalAIAssist – Root .env (used by Docker Compose)
# Copy to .env and fill in values.
# ──────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED) ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# For public / tunnel deploys set ENVIRONMENT=production in backend/.env
# ALLOW_REGISTRATION=false
# REGISTRATION_ALLOWED_EMAILS=you@gmail.com
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Google sign-in (OAuth) — not the same as GOOGLE_API_KEY (Gemini) ─
# Create a Web client in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI:
#   http://localhost:8000/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/auth/callback

# ── LLM Provider (cursor | openai | anthropic | gemini | openrouter)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── LLM API Keys (set only the ones you use) ────────────────────────
# CURSOR_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# ── Reranker (optional) ─────────────────────────────────────────────
# COHERE_API_KEY=

# ── Qdrant ───────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Database (set in docker-compose.yml for containers; omit for local dev)
# DATABASE_URL=sqlite+aiosqlite:///data/app.db

# ── Observability (optional) ─────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# ── Frontend ─────────────────────────────────────────────────────────
# Browser calls same-origin /api/v1; Next.js rewrites to BACKEND_URL (see frontend/next.config.ts).
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=http://127.0.0.1:8000
