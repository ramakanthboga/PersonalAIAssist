# ──────────────────────────────────────────────────────────────────────
# PersonalAIAssist – Backend Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────
APP_NAME=PersonalAIAssist
ENVIRONMENT=development          # development | staging | production
# API docs (/docs, /redoc, /openapi.json) are ONLY enabled when ENVIRONMENT=development
DEBUG=false

# ── Auth / JWT (set in root .env – do not override with placeholder here) ─
# SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Public exposure: disable open signup (or allowlist your email only)
ALLOW_REGISTRATION=true
# REGISTRATION_ALLOWED_EMAILS=you@gmail.com

# ── Google sign-in (OAuth Web client) ────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/auth/callback

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated exact origins (no *). Add your Vercel URL when public.
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
# SQLite (dev default):
# DATABASE_URL=sqlite+aiosqlite:///data/app.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/personalai

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant Vector DB ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=               # Set in production

# ── LLM Provider (cursor | openai | anthropic | gemini | openrouter)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── LLM API Keys (set only the ones you use) ────────────────────────
# CURSOR_API_KEY=
# OPENAI_API_KEY=              # Do not leave blank – comment out if unused
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64

# ── Reranker ─────────────────────────────────────────────────────────
# COHERE_API_KEY=
RERANKER_MODEL=rerank-english-v3.0
RERANKER_TOP_K=5

# ── RAG ──────────────────────────────────────────────────────────────
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=10
MIN_RETRIEVAL_SCORE=0.32
MIN_RERANK_SCORE=0.20
SYNTHESIS_RETRIEVAL_TOP_K=30
SYNTHESIS_CONTEXT_CHUNKS=24

# ── File Uploads ─────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Celery ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Observability (Langfuse – optional) ─────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=10
